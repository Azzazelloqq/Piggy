  m_Script: {fileID: 11500000, guid: 2166528eb5e14ee3b8e453e3c2757d99, type: 3}
  m_Name: CharactersConfigPage
  m_EditorClassIdentifier: GameConfig::Code.Config.Pages.CharactersPage.CharactersConfigPage
  _allTraitsIds:
  - _id: character_traits_brave
    _localisationKey: character_trait_brave
    _description: "A character who faces danger without hesitation.\n They protect
      allies, take responsibility, a\nnd often put others before themselves. \nEven
      in hopeless situations, they refuse to give up."
  - _id: character_traits_cunning
    _localisationKey: character_trait_cunning
    _description: "A character who prefers brains over brute force.\nThey solve problems
      with strategy, deception, \nor negotiation. Sometimes morally ambiguous \nbut
      extremely effectiv"
  - _id: character_traits_calm
    _localisationKey: character_trait_calm
    _description: "A character who remains calm under pressure. \nThey think before
      acting and rely on logic rather \nthan emotion.\n Often the strategist or advisor
      of the group."
  _statsConfig:
    _maxSumCharacterPoints: 5
    _defaultStatValue: 10
    _stats:
    - _type: 0
      _localisationKey: character_stats_strenght
      _fallbackLabel: 
    - _type: 1
